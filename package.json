{
  "name": "@zionzionzion/pi-extensions",
  "version": "0.1.4",
  "description": "Zion's pi extensions: reload-all, auto-hide-thinking, codex-usage, magpie-quota, model-label, checkpoint, commits and more",
  "type": "module",
  "license": "UNLICENSED",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zion-zion-zion/pi-extension.git"
  },
  "files": [
    "extensions/*.ts",
    "extensions/codex-usage",
    "extensions/magpie-quota",
    "extensions/reload-all",
    "skills",
    "README.md"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test extensions/codex-usage/*.test.ts extensions/magpie-quota/*.test.ts extensions/reload-all/*.test.ts extensions/model-label/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "extensions/*.ts",
      "extensions/codex-usage/index.ts",
      "extensions/magpie-quota/index.ts",
      "extensions/reload-all/index.ts"
    ],
    "skills": [
      "skills"
    ]
  }
}
